QWidget {
    background: $WINDOW;
    color: $TEXT;
    font-size: 13px;
}
QWidget:disabled {
    color: $TEXT_DISABLED;
}
QLabel, QCheckBox, QRadioButton {
    background: transparent;
}
QToolTip {
    background: $SURFACE;
    color: $TEXT;
    border: 1px solid $BORDER_STRONG;
    padding: 4px 6px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid $BORDER_STRONG;
    border-radius: 3px;
    background: $SURFACE;
}
QCheckBox::indicator:hover {
    border-color: $ACCENT;
}
QCheckBox::indicator:checked {
    background: $ACCENT_FILL;
    border-color: $ACCENT;
    image: url(icons/check.svg);
}
QCheckBox::indicator:disabled {
    background: $PANEL;
    border-color: $BORDER;
}
QCheckBox::indicator:checked:disabled {
    background: $SURFACE_PRESSED;
    border-color: $SURFACE_PRESSED;
}
QWidget#tabContent, QScrollArea > QWidget > QWidget#tabContent {
    background: transparent;
}
QPushButton {
    background: $ACCENT_FILL;
    color: $ON_ACCENT;
    border: 1px solid $ACCENT_FILL;
    border-radius: 4px;
    padding: 9px 16px;
    font-weight: 600;
}
QPushButton:hover {
    background: $ACCENT_FILL_HOVER;
}
QPushButton:disabled {
    background: $SURFACE;
    border-color: $BORDER;
    color: $TEXT_DISABLED;
}
QPushButton:checked {
    background: $ACCENT_FILL_HOVER;
    border-color: $ACCENT;
}
QPushButton#secondaryButton {
    background: $SURFACE;
    color: $TEXT;
    border: 1px solid $BORDER_STRONG;
}
QPushButton#secondaryButton:hover {
    background: $SURFACE_HOVER;
    border-color: $ACCENT;
}
QPushButton#secondaryButton:pressed {
    background: $SURFACE_PRESSED;
}
QPushButton#secondaryButton:disabled {
    background: $PANEL;
    color: $TEXT_DISABLED;
    border-color: $BORDER;
}
QPushButton#transportButton {
    background: $SURFACE;
    border: 1px solid $BORDER_STRONG;
    border-radius: 4px;
    padding: 4px;
}
QPushButton#transportButton:hover {
    background: $SURFACE_HOVER;
    border-color: $ACCENT;
}
QPushButton#transportButton:pressed {
    background: $SURFACE_PRESSED;
}
QPushButton#transportButton:disabled {
    background: $PANEL;
    border-color: $BORDER;
}
QPushButton#transportPlayButton {
    padding: 4px;
    border-radius: 5px;
}
QLabel#hintLabel, QLabel#frameLabel {
    color: $TEXT_MUTED;
}
QLabel#timecodeLabel {
    font-weight: 600;
    color: $ACCENT;
}
QPushButton#previewOpenButton {
    padding: 12px 22px;
    font-size: 14px;
}
QToolButton {
    background: $SURFACE;
    color: $TEXT;
    border: 1px solid $BORDER_STRONG;
    border-radius: 4px;
}
QToolButton:hover {
    background: $SURFACE_HOVER;
}
QToolButton#resetButton {
    background: transparent;
    border: none;
    padding: 3px;
}
QToolButton#resetButton:hover {
    background: $SURFACE_HOVER;
}
QToolButton#resetButton:pressed {
    background: $SURFACE_PRESSED;
}
QToolButton#filterPresetButton {
    background: $SURFACE;
    border: 1px solid $BORDER;
    border-radius: 6px;
    padding: 8px;
    color: $TEXT;
    font-weight: 600;
}
QToolButton#filterPresetButton:hover {
    background: $SURFACE_HOVER;
}
QToolButton#filterPresetButton:checked {
    border: 2px solid $ACCENT;
    background: $SURFACE_PRESSED;
}
QGroupBox {
    border: 1px solid $BORDER;
    border-radius: 6px;
    margin-top: 14px;
    padding: 18px 14px 14px 14px;
    background: $PANEL;
    font-weight: 600;
}
QGroupBox:title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: $TEXT_MUTED;
}
QMenuBar {
    background: $PANEL;
    border-bottom: 1px solid $BORDER;
    padding: 4px 8px;
}
QMenuBar::item {
    padding: 6px 10px;
    border-radius: 4px;
    background: transparent;
}
QMenuBar::item:selected {
    background: $SURFACE_HOVER;
}
QMenu {
    background: $PANEL;
    border: 1px solid $BORDER_STRONG;
    padding: 6px;
}
QMenu::item {
    padding: 7px 18px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: $ACCENT_FILL;
    color: $ON_ACCENT;
}
QMenu::item:disabled {
    color: $TEXT_DISABLED;
}
QMenu::separator {
    height: 1px;
    background: $BORDER;
    margin: 5px 8px;
}
QWidget#previewBar {
    background: transparent;
}
QWidget#previewBar QLabel {
    color: $TEXT_MUTED;
}
QToolButton#previewZoomButton {
    background: $SURFACE;
    border: 1px solid $BORDER;
    border-radius: 4px;
    padding: 3px 7px;
    min-width: 22px;
    color: $TEXT;
    font-weight: 600;
}
QToolButton#previewZoomButton:hover {
    background: $SURFACE_HOVER;
    border-color: $ACCENT;
}
QToolButton#previewZoomButton:checked {
    background: $ACCENT_FILL;
    border-color: $ACCENT;
    color: $ON_ACCENT;
}
QToolButton#previewZoomButton:disabled {
    background: $PANEL;
    color: $TEXT_DISABLED;
    border-color: $BORDER;
}
QToolButton#previewToggle {
    background: $SURFACE;
    border: 1px solid $BORDER;
    border-radius: 4px;
    padding: 4px 9px;
    color: $TEXT;
    font-weight: 600;
}
QToolButton#previewToggle:hover {
    background: $SURFACE_HOVER;
    border-color: $ACCENT;
}
QToolButton#previewToggle:checked {
    background: $ACCENT_FILL;
    border-color: $ACCENT;
    color: $ON_ACCENT;
}
QToolButton#timelineToolButton {
    background: $SURFACE;
    border: 1px solid $BORDER_STRONG;
    border-radius: 4px;
    padding: 2px;
}
QToolButton#timelineToolButton:hover {
    background: $SURFACE_HOVER;
    border-color: $ACCENT;
}
QToolButton#timelineToolButton:pressed {
    background: $SURFACE_PRESSED;
}
QToolButton#timelineToolButton:checked {
    background: $SURFACE_PRESSED;
    border: 2px solid $WARNING;
}
QToolButton#timelineToolButton:disabled {
    background: $PANEL;
    border-color: $BORDER;
}
QSplitter::handle {
    background: transparent;
}
QSplitter::handle:hover {
    background: $BORDER;
}
QTabWidget::pane {
    border: 1px solid $BORDER;
    border-radius: 6px;
    background: $PANEL;
    top: -1px;
}
QTabBar::tab {
    background: $WINDOW;
    border: 1px solid $BORDER;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 10px 10px;
    margin-right: 2px;
    color: $TEXT_MUTED;
    font-weight: 600;
}
QTabBar::tab:hover {
    color: $TEXT;
    background: $SURFACE;
}
QTabBar::tab:selected {
    background: $PANEL;
    color: $TEXT;
    border-top: 2px solid $ACCENT;
}
QTabBar::tab:!selected {
    margin-top: 3px;
}
QSlider {
    background: transparent;
}
QSlider::groove:horizontal {
    border-radius: 2px;
    height: 4px;
    background: $SURFACE_PRESSED;
}
QSlider::sub-page:horizontal {
    border-radius: 2px;
    background: $ACCENT_FILL;
}
QSlider::handle:horizontal {
    background: $TEXT;
    border: 2px solid $ACCENT;
    width: 12px;
    margin: -6px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background: $ON_ACCENT;
}
QSlider::sub-page:horizontal:disabled {
    background: $BORDER_STRONG;
}
QSlider::handle:horizontal:disabled {
    background: $TEXT_DISABLED;
    border-color: $BORDER_STRONG;
}
QComboBox {
    background: $SURFACE;
    color: $TEXT;
    border: 1px solid $BORDER;
    border-radius: 4px;
    padding: 6px 10px;
}
QComboBox:hover {
    border-color: $BORDER_STRONG;
}
QComboBox:disabled {
    background: $PANEL;
    color: $TEXT_DISABLED;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: url(icons/chevron-down.svg);
    width: 10px;
    height: 10px;
}
QComboBox::down-arrow:disabled {
    image: none;
}
QComboBox QAbstractItemView {
    background: $PANEL;
    color: $TEXT;
    border: 1px solid $BORDER_STRONG;
    selection-background-color: $ACCENT_FILL;
    selection-color: $ON_ACCENT;
    outline: none;
}
QPlainTextEdit {
    background: $VIEWER;
    color: $TEXT;
    border: 1px solid $BORDER;
    border-radius: 4px;
    selection-background-color: $ACCENT_FILL;
}
QScrollArea {
    border: none;
    background: transparent;
}
QScrollArea#previewScrollArea {
    background: $VIEWER;
    border: 1px solid $BORDER;
    border-radius: 6px;
}
QScrollArea#previewScrollArea > QWidget > QWidget {
    background: $VIEWER;
}
QScrollBar:horizontal {
    background: $WINDOW;
    height: 12px;
    border: none;
}
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    border: none;
}
QScrollBar::handle:horizontal, QScrollBar::handle:vertical {
    background: $SURFACE_PRESSED;
    border-radius: 4px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    min-width: 24px;
}
QScrollBar::handle:vertical {
    min-height: 24px;
}
QScrollBar::handle:hover {
    background: $BORDER_STRONG;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}
QProgressBar {
    border: 1px solid $BORDER;
    border-radius: 4px;
    background: $SURFACE;
    text-align: center;
    min-height: 20px;
    color: $TEXT;
}
QProgressBar::chunk {
    border-radius: 3px;
    background: $ACCENT_FILL;
}
QStatusBar {
    background: $PANEL;
    border-top: 1px solid $BORDER;
}
QStatusBar::item {
    border: none;
}
QWidget#statusPanel {
    background: transparent;
}
QLabel#renderIndicator {
    color: $WARNING;
    font-weight: 600;
}
QLabel#videoInfo {
    color: $TEXT_MUTED;
}
QProgressBar#statusProgress {
    min-height: 14px;
    max-height: 16px;
    font-size: 11px;
    border-radius: 3px;
}
QProgressBar#statusProgress::chunk {
    border-radius: 2px;
}
QPushButton#statusCancel, QPushButton#statusReveal {
    padding: 4px 12px;
    font-size: 12px;
    border-radius: 4px;
}
QPushButton#statusCancel {
    background: $DANGER_FILL;
    border-color: $DANGER_FILL;
}
QPushButton#statusCancel:hover {
    background: $DANGER;
}
QPushButton#statusCancel:disabled {
    background: $SURFACE;
    border-color: $BORDER;
}
QPushButton#statusReveal {
    background: $SURFACE;
    color: $ACCENT;
    border: 1px solid $ACCENT_FILL;
}
QPushButton#statusReveal:hover {
    background: $SURFACE_HOVER;
}
QWidget#previewPaused {
    background: $VIEWER;
    border: 1px solid $BORDER;
    border-radius: 6px;
}
QLabel#previewPausedTitle {
    color: $TEXT;
    font-size: 15px;
    font-weight: 600;
}
QLabel#previewPausedHint {
    color: $TEXT_MUTED;
}
QWidget#monitorWindow, QWidget#monitorWindow > QWidget {
    background: $VIEWER;
    color: $TEXT;
}
QWidget#monitorControls {
    background: $PANEL;
    border-top: 1px solid $BORDER;
}
QLabel#monitorTimecode {
    color: $ACCENT;
    font-weight: 600;
}
QPushButton#monitorButton, QPushButton#monitorPlayButton {
    background: $SURFACE;
    border: 1px solid $BORDER_STRONG;
    border-radius: 4px;
    padding: 4px;
}
QPushButton#monitorPlayButton {
    background: $ACCENT_FILL;
    border-color: $ACCENT_FILL;
    border-radius: 5px;
}
QPushButton#monitorButton:hover {
    background: $SURFACE_HOVER;
    border-color: $ACCENT;
}
QPushButton#monitorPlayButton:hover {
    background: $ACCENT_FILL_HOVER;
}
QPushButton#monitorButton:disabled, QPushButton#monitorPlayButton:disabled {
    background: $PANEL;
    border-color: $BORDER;
}
QToolButton#monitorToggle {
    background: $SURFACE;
    border: 1px solid $BORDER_STRONG;
    border-radius: 4px;
    padding: 4px 12px;
    color: $TEXT;
    font-weight: 600;
}
QToolButton#monitorToggle:hover {
    background: $SURFACE_HOVER;
    border-color: $ACCENT;
}
QToolButton#monitorToggle:checked {
    background: $ACCENT_FILL;
    border-color: $ACCENT;
    color: $ON_ACCENT;
}
QComboBox#monitorCombo {
    padding: 3px 10px;
}
QSlider#monitorScrubber::groove:horizontal {
    height: 4px;
    background: $SURFACE_PRESSED;
    border-radius: 2px;
}
QSlider#monitorScrubber::sub-page:horizontal {
    background: $ACCENT;
    border-radius: 2px;
}
QSlider#monitorScrubber::handle:horizontal {
    width: 12px;
    margin: -5px 0;
    background: $TEXT;
    border: none;
    border-radius: 6px;
}
QSlider#monitorScrubber::handle:horizontal:disabled {
    background: $TEXT_DISABLED;
}
