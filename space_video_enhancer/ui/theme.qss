QWidget {
    background: #fcfaf7;
    color: #1f2937;
    font-size: 13px;
}
QLabel, QCheckBox, QRadioButton {
    background: transparent;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #9ca3af;
    border-radius: 4px;
    background: white;
}
QCheckBox::indicator:hover {
    border-color: #0f766e;
}
QCheckBox::indicator:checked {
    background: #0f766e;
    border-color: #0f766e;
    image: url(icons/check.svg);
}
QCheckBox::indicator:disabled {
    background: #efe9de;
    border-color: #d6d3d1;
}
QCheckBox::indicator:checked:disabled {
    background: #9ca3af;
    border-color: #9ca3af;
}
QWidget#tabContent, QScrollArea > QWidget > QWidget#tabContent {
    background: transparent;
}
QPushButton {
    background: #0f766e;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 10px 16px;
    font-weight: 600;
}
QPushButton:disabled {
    background: #9ca3af;
}
QPushButton:checked {
    background: #115e59;
}
QPushButton#secondaryButton {
    background: white;
    color: #0f766e;
    border: 1px solid #a8a29e;
}
QPushButton#secondaryButton:hover {
    background: #ecfeff;
    border-color: #0f766e;
}
QPushButton#secondaryButton:disabled {
    background: #f8f5ef;
    color: #9ca3af;
    border-color: #e7e5e4;
}
QPushButton#transportButton {
    background: white;
    border: 1px solid #a8a29e;
    border-radius: 10px;
    padding: 4px;
}
QPushButton#transportButton:hover {
    background: #ecfeff;
    border-color: #0f766e;
}
QPushButton#transportButton:disabled {
    background: #f8f5ef;
    border-color: #e7e5e4;
}
QPushButton#transportPlayButton {
    padding: 4px;
    border-radius: 12px;
}
QLabel#hintLabel, QLabel#frameLabel {
    color: #6b7280;
}
QLabel#timecodeLabel {
    font-weight: 600;
}
QPushButton#previewOpenButton {
    padding: 12px 22px;
    font-size: 14px;
}
QToolButton#filterPresetButton {
    background: white;
    border: 1px solid #d6d3d1;
    border-radius: 12px;
    padding: 8px;
    color: #1f2937;
    font-weight: 600;
}
QToolButton#filterPresetButton:checked {
    border: 2px solid #0f766e;
    background: #ecfeff;
}
QGroupBox {
    border: 1px solid #d6d3d1;
    border-radius: 14px;
    margin-top: 14px;
    padding: 18px 14px 14px 14px;
    background: #f8f5ef;
    font-weight: 600;
}
QGroupBox:title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}
QMenuBar {
    background: #f8f5ef;
    border-bottom: 1px solid #d6d3d1;
    padding: 4px 8px;
}
QMenuBar::item {
    padding: 6px 10px;
    border-radius: 8px;
    background: transparent;
}
QMenuBar::item:selected {
    background: #efe9de;
}
QMenu {
    background: #fffdf8;
    border: 1px solid #d6d3d1;
    padding: 6px;
}
QMenu::item {
    padding: 8px 18px;
    border-radius: 8px;
}
QMenu::item:selected {
    background: #0f766e;
    color: white;
}
QWidget#previewBar {
    background: transparent;
}
QWidget#previewBar QLabel {
    color: #4b5563;
}
QToolButton#previewZoomButton {
    background: white;
    border: 1px solid #d6d3d1;
    border-radius: 8px;
    padding: 3px 9px;
    min-width: 22px;
    color: #1f2937;
    font-weight: 600;
}
QToolButton#previewZoomButton:hover {
    background: #ecfeff;
    border-color: #0f766e;
}
QToolButton#previewZoomButton:checked {
    background: #0f766e;
    border-color: #0f766e;
    color: white;
}
QToolButton#previewZoomButton:disabled {
    background: #f8f5ef;
    color: #9ca3af;
    border-color: #e7e5e4;
}
QToolButton#previewToggle {
    background: white;
    border: 1px solid #d6d3d1;
    border-radius: 8px;
    padding: 4px 12px;
    color: #1f2937;
    font-weight: 600;
}
QToolButton#previewToggle:hover {
    background: #ecfeff;
    border-color: #0f766e;
}
QToolButton#previewToggle:checked {
    background: #0f766e;
    border-color: #0f766e;
    color: white;
}
QToolButton#timelineToolButton {
    background: white;
    border: 1px solid #a8a29e;
    border-radius: 8px;
    padding: 2px;
}
QToolButton#timelineToolButton:hover {
    background: #ecfeff;
    border-color: #0f766e;
}
QToolButton#timelineToolButton:pressed {
    background: #cffafe;
}
QToolButton#timelineToolButton:checked {
    background: #fef3c7;
    border: 2px solid #b45309;
}
QToolButton#timelineToolButton:disabled {
    background: #f8f5ef;
    border-color: #e7e5e4;
}
QSplitter::handle {
    background: transparent;
}
QTabWidget::pane {
    border: 1px solid #d6d3d1;
    border-radius: 14px;
    background: #f8f5ef;
    top: -1px;
}
QTabBar::tab {
    background: #efe9de;
    border: 1px solid #d6d3d1;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 10px 10px;
    margin-right: 4px;
    color: #4b5563;
    font-weight: 600;
}
QTabBar::tab:selected {
    background: #0f766e;
    color: white;
}
QTabBar::tab:!selected {
    margin-top: 3px;
}
QSlider::groove:horizontal {
    border-radius: 999px;
    height: 8px;
    background: #d6d3d1;
}
QSlider::handle:horizontal {
    background: #0f766e;
    border: 2px solid #ecfeff;
    width: 16px;
    margin: -5px 0;
    border-radius: 8px;
}
QComboBox {
    background: white;
    border: 1px solid #d6d3d1;
    border-radius: 8px;
    padding: 6px 10px;
}
QScrollArea {
    border: none;
    background: transparent;
}
QScrollArea#previewScrollArea {
    background: #f3f4f6;
    border: 1px solid #d6d3d1;
    border-radius: 14px;
}
QScrollArea#previewScrollArea > QWidget > QWidget {
    background: #f3f4f6;
}
QProgressBar {
    border: 1px solid #d6d3d1;
    border-radius: 9px;
    background: #efe9de;
    text-align: center;
    min-height: 20px;
    color: #1f2937;
}
QProgressBar::chunk {
    border-radius: 8px;
    background: #0f766e;
}
QStatusBar {
    background: #f8f5ef;
    border-top: 1px solid #d6d3d1;
}
QStatusBar::item {
    border: none;
}
QWidget#statusPanel {
    background: transparent;
}
QLabel#renderIndicator {
    color: #b45309;
    font-weight: 600;
}
QLabel#videoInfo {
    color: #4b5563;
}
QProgressBar#statusProgress {
    min-height: 14px;
    max-height: 16px;
    font-size: 11px;
    border-radius: 7px;
}
QProgressBar#statusProgress::chunk {
    border-radius: 6px;
}
QPushButton#statusCancel, QPushButton#statusReveal {
    padding: 4px 12px;
    font-size: 12px;
    border-radius: 8px;
}
QPushButton#statusCancel {
    background: #b91c1c;
}
QPushButton#statusCancel:disabled {
    background: #9ca3af;
}
QPushButton#statusReveal {
    background: white;
    color: #0f766e;
    border: 1px solid #0f766e;
}
QWidget#monitorWindow, QWidget#monitorWindow > QWidget {
    background: #0b0f19;
    color: #e5e7eb;
}
QWidget#monitorControls {
    background: #111827;
    border-top: 1px solid #1f2937;
}
QLabel#monitorTimecode {
    color: #e5e7eb;
    font-weight: 600;
}
QPushButton#monitorButton, QPushButton#monitorPlayButton {
    background: #1f2937;
    border: 1px solid #374151;
    border-radius: 10px;
    padding: 4px;
}
QPushButton#monitorPlayButton {
    background: #0f766e;
    border-color: #0f766e;
    border-radius: 12px;
}
QPushButton#monitorButton:hover {
    background: #374151;
    border-color: #14b8a6;
}
QPushButton#monitorPlayButton:hover {
    background: #0d9488;
}
QPushButton#monitorButton:disabled, QPushButton#monitorPlayButton:disabled {
    background: #111827;
    border-color: #1f2937;
}
QToolButton#monitorToggle {
    background: #1f2937;
    border: 1px solid #374151;
    border-radius: 8px;
    padding: 4px 12px;
    color: #e5e7eb;
    font-weight: 600;
}
QToolButton#monitorToggle:hover {
    background: #374151;
    border-color: #14b8a6;
}
QToolButton#monitorToggle:checked {
    background: #0f766e;
    border-color: #0f766e;
    color: white;
}
QComboBox#monitorCombo {
    background: #1f2937;
    color: #e5e7eb;
    border: 1px solid #374151;
    border-radius: 8px;
    padding: 3px 10px;
}
QComboBox#monitorCombo::drop-down {
    border: none;
    width: 18px;
}
QComboBox#monitorCombo QAbstractItemView {
    background: #1f2937;
    color: #e5e7eb;
    selection-background-color: #0f766e;
    selection-color: white;
}
QSlider#monitorScrubber::groove:horizontal {
    height: 4px;
    background: #374151;
    border-radius: 2px;
}
QSlider#monitorScrubber::sub-page:horizontal {
    background: #14b8a6;
    border-radius: 2px;
}
QSlider#monitorScrubber::handle:horizontal {
    width: 12px;
    margin: -5px 0;
    background: #f9fafb;
    border-radius: 6px;
}
QSlider#monitorScrubber::handle:horizontal:disabled {
    background: #4b5563;
}
